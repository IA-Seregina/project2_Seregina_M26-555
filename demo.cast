[16.835480213165283,"o","\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r"]
[16.83566665649414,"o","\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r"]
